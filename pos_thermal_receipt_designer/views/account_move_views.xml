<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_thermal_receipt" model="ir.ui.view">
        <field name="name">account.move.form.inherit.thermal.receipt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Header Button to Print Thermal Mini Receipt -->
            <xpath expr="//header" position="inside">
                <button name="action_print_thermal_receipt"
                        string="Cetak Struk Kasir"
                        type="object"
                        class="btn-secondary"
                        icon="fa-print"
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>

            <!-- Template Selector Field -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="thermal_template_id"
                       options="{'no_create': True}"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       placeholder="Template Struk Thermal (Opsional)..."/>
            </xpath>
        </field>
    </record>
</odoo>
