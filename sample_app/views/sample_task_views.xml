<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_sample_task_list" model="ir.ui.view">
        <field name="name">sample.task.list</field>
        <field name="model">sample.task</field>
        <field name="arch" type="xml">
            <list string="Tasks">
                <field name="name"/>
                <field name="user_id"/>
                <field name="date_deadline"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sample_task_form" model="ir.ui.view">
        <field name="name">sample.task.form</field>
        <field name="model">sample.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <header>
                    <button name="action_start" string="Start Task" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark as Done" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Task Title"/>
                        <h1>
                            <field name="name" placeholder="Contoh: Implementasi Fitur Baru..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="date_deadline"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deskripsi" name="description_page">
                            <field name="description" placeholder="Tuliskan catatan atau instruksi task di sini..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sample_task_search" model="ir.ui.view">
        <field name="name">sample.task.search</field>
        <field name="model">sample.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">
                <field name="name"/>
                <field name="user_id"/>
                <filter string="My Tasks" name="my_tasks" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="state_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="state_done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Assigned User" name="group_by_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_sample_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">sample.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sample_task_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat task pertama Anda!
            </p>
            <p>
                Ini adalah contoh modul custom Odoo 18. Anda dapat menambahkan task, mengubah status, dan memodifikasi model ini.
            </p>
        </field>
    </record>
</odoo>
