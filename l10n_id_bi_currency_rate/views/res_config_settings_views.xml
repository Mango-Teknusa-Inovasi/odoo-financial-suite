<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bi_rate" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bi.rate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Kurs Bank Indonesia &amp; Kemenkeu" id="bi_rate_settings_block">
                    <setting id="bi_rate_sync_setting"
                             help="Pembaruan otomatis harian nilai tukar valuta asing resmi Bank Indonesia (JISDOR/Kurs Tengah) dan Kemenkeu.">
                        <field name="bi_sync_enabled"/>
                        <div class="content-group" invisible="not bi_sync_enabled">
                            <div class="row mt-2">
                                <label string="Metode Penentuan Kurs" for="bi_rate_source" class="col-lg-4 o_light_label"/>
                                <field name="bi_rate_source" class="col-lg-8"/>
                            </div>
                            <div class="row mt-2" invisible="not bi_last_sync_date">
                                <label string="Terakhir Disinkronkan" for="bi_last_sync_date" class="col-lg-4 o_light_label"/>
                                <div class="col-lg-8">
                                    <field name="bi_last_sync_date" readonly="1" class="fw-bold"/>
                                    <span class="badge bg-success ms-2" invisible="bi_last_sync_status != 'success'">Berhasil</span>
                                    <span class="badge bg-warning ms-2" invisible="bi_last_sync_status != 'warning'">Fallback</span>
                                    <span class="badge bg-danger ms-2" invisible="bi_last_sync_status != 'failed'">Gagal</span>
                                </div>
                            </div>
                            <div class="row mt-1" invisible="not bi_last_sync_message">
                                <div class="col-lg-12 text-muted small">
                                    <field name="bi_last_sync_message" readonly="1"/>
                                </div>
                            </div>
                            <div class="mt-3">
                                <button name="action_sync_bi_rates_now" type="object"
                                        string="Tarik Kurs Sekarang" class="btn btn-primary" icon="fa-refresh"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
