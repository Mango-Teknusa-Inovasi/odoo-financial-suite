<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_bi_rate_sync_log_list" model="ir.ui.view">
        <field name="name">bi.rate.sync.log.list</field>
        <field name="model">bi.rate.sync.log</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'success'"
                  decoration-warning="status == 'warning'"
                  decoration-danger="status == 'failed'">
                <field name="name"/>
                <field name="sync_date"/>
                <field name="target_date"/>
                <field name="source_used"/>
                <field name="currency_count"/>
                <field name="currencies_updated"/>
                <field name="status" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bi_rate_sync_log_form" model="ir.ui.view">
        <field name="name">bi.rate.sync.log.form</field>
        <field name="model">bi.rate.sync.log</field>
        <field name="arch" type="xml">
            <form string="Log Sinkronisasi Kurs BI">
                <sheet>
                    <div class="oe_title">
                        <span class="text-muted font-weight-bold">Log Sinkronisasi</span>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Waktu &amp; Tanggal">
                            <field name="sync_date"/>
                            <field name="target_date"/>
                            <field name="status" widget="badge"/>
                        </group>
                        <group string="Sumber &amp; Jangkauan">
                            <field name="source_used"/>
                            <field name="currency_count"/>
                            <field name="currencies_updated"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="tab_summary" string="Rincian Kurs Valas Terbarui">
                            <field name="summary" nolabel="1" widget="text"/>
                        </page>
                        <page name="tab_errors" string="Catatan Teknis / Error" invisible="not error_message">
                            <field name="error_message" nolabel="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bi_rate_sync_log_search" model="ir.ui.view">
        <field name="name">bi.rate.sync.log.search</field>
        <field name="model">bi.rate.sync.log</field>
        <field name="arch" type="xml">
            <search string="Cari Log Sinkronisasi">
                <field name="name"/>
                <field name="source_used"/>
                <field name="currencies_updated"/>
                <filter string="Berhasil" name="filter_success" domain="[('status', '=', 'success')]"/>
                <filter string="Fallback / Peringatan" name="filter_warning" domain="[('status', '=', 'warning')]"/>
                <filter string="Gagal" name="filter_failed" domain="[('status', '=', 'failed')]"/>
                <group expand="0" string="Kelompokkan Berdasarkan">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Tanggal" name="group_target_date" context="{'group_by': 'target_date'}"/>
                    <filter string="Perusahaan" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bi_rate_sync_log" model="ir.actions.act_window">
        <field name="name">Riwayat Sinkronisasi Kurs BI</field>
        <field name="res_model">bi.rate.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bi_rate_sync_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada riwayat sinkronisasi kurs Bank Indonesia.
            </p>
        </field>
    </record>
</odoo>
