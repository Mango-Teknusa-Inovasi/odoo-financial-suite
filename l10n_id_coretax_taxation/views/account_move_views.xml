<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_l10n_id_coretax" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n.id.coretax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Bukti Potong &amp; Coretax" name="bupot_coretax_tab">
                    <group>
                        <group string="Dokumen Bukti Potong (Bupot)">
                            <field name="l10n_id_bupot_number" placeholder="Nomor Bupot Resmi"/>
                            <field name="l10n_id_bupot_date"/>
                            <field name="l10n_id_tax_object_code" placeholder="Kode Objek Pajak"/>
                        </group>
                        <group string="Status Regulasi DJP">
                            <field name="l10n_id_umkm_settlement_type"/>
                            <field name="l10n_id_coretax_exported"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
