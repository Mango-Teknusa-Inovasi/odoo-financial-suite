<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form_inherit_l10n_id_coretax" model="ir.ui.view">
        <field name="name">account.tax.form.inherit.l10n.id.coretax</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type_tax_use']" position="after">
                <field name="l10n_id_tax_type"/>
                <field name="l10n_id_tax_object_code" placeholder="e.g. 24-104-01"/>
                <field name="l10n_id_is_withholding"/>
            </xpath>
        </field>
    </record>
</odoo>
