<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice Tree View Inheritance -->
    <record id="view_invoice_tree_opening_balance_inherit" model="ir.ui.view">
        <field name="name">account.invoice.tree.opening.balance.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field name="is_opening_balance" widget="boolean_toggle" optional="hide" string="Saldo Awal"/>
            </xpath>
        </field>
    </record>

    <!-- Invoice Form View Inheritance -->
    <record id="view_move_form_opening_balance_inherit" model="ir.ui.view">
        <field name="name">account.move.form.opening.balance.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-info py-2 px-3 mb-0" role="alert" invisible="not is_opening_balance">
                    <span class="fa fa-info-circle me-1" title="Info"/>
                    <strong>Dokumen Saldo Awal:</strong> Tagihan ini dibuat secara otomatis dari Opening Balance Setup Wizard untuk melacak sisa piutang/hutang historis.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
