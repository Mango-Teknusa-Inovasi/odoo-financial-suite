<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Company Record Rule: Marketplace Channel -->
        <record id="marketplace_channel_comp_rule" model="ir.rule">
            <field name="name">Marketplace Channel Multi-Company</field>
            <field name="model_id" ref="model_marketplace_channel"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Multi-Company Record Rule: Marketplace Settlement Batch -->
        <record id="marketplace_settlement_batch_comp_rule" model="ir.rule">
            <field name="name">Marketplace Settlement Batch Multi-Company</field>
            <field name="model_id" ref="model_marketplace_settlement_batch"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
