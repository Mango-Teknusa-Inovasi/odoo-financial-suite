<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Marketplace Channel List -->
    <record id="view_marketplace_channel_list" model="ir.ui.view">
        <field name="name">marketplace.channel.list</field>
        <field name="model">marketplace.channel</field>
        <field name="arch" type="xml">
            <list string="Marketplace Channels">
                <field name="name"/>
                <field name="platform"/>
                <field name="journal_id"/>
                <field name="escrow_account_id"/>
                <field name="revenue_account_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Marketplace Channel Form -->
    <record id="view_marketplace_channel_form" model="ir.ui.view">
        <field name="name">marketplace.channel.form</field>
        <field name="model">marketplace.channel</field>
        <field name="arch" type="xml">
            <form string="Marketplace Channel">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Channel Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Shopee Official Store, Tokopedia Gadget"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Platform Configuration">
                            <field name="platform"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Accounting Integration">
                            <field name="journal_id"/>
                            <field name="escrow_account_id"/>
                            <field name="revenue_account_id"/>
                            <field name="fee_account_id"/>
                            <field name="shipping_account_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_marketplace_channel" model="ir.actions.act_window">
        <field name="name">Sales Channels</field>
        <field name="res_model">marketplace.channel</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your first online sales channel!
            </p>
            <p>
                Map clearing escrow accounts and commission expense accounts for Shopee, Tokopedia, TikTok Shop, or custom marketplace stores.
            </p>
        </field>
    </record>
</odoo>
