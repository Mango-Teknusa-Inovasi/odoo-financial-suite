<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit and Extend Invoice Document QWeb Template -->
    <template id="report_invoice_document_stamp_emeterai" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <!-- Official Stamp, Signature & e-Meterai Container -->
            <div t-if="o.company_id.stamp_enabled or o.emeterai_status == 'stamped'" 
                 class="mt-4 pt-3" 
                 style="page-break-inside: avoid;">
                
                <div class="row align-items-end justify-content-between">
                    <!-- Left Column: Official e-Meterai Peruri Seal (if stamped) -->
                    <div class="col-6">
                        <t t-if="o.emeterai_status == 'stamped'">
                            <div style="border: 2px dashed #DC2626; border-radius: 8px; background-color: #FEF2F2; padding: 10px; max-width: 320px;">
                                <div class="d-flex align-items-center">
                                    <div style="margin-right: 12px;">
                                        <img t-if="o.emeterai_qr_code" 
                                             t-att-src="'/report/barcode/?barcode_type=QR&amp;value=' + o.emeterai_qr_code + '&amp;width=90&amp;height=90'" 
                                             style="width: 70px; height: 70px; border: 1px solid #DC2626; border-radius: 4px; background: white; padding: 2px;"/>
                                    </div>
                                    <div style="font-size: 10px; line-height: 1.3;">
                                        <div style="color: #991B1B; font-weight: bold; font-size: 11px; text-transform: uppercase;">
                                            BEA METERAI LUNAS
                                        </div>
                                        <div style="color: #DC2626; font-weight: 800; font-size: 13px;">
                                            Rp 10.000,-
                                        </div>
                                        <div style="color: #4B5563; font-family: monospace; font-size: 9px; margin-top: 2px;">
                                            SN: <t t-esc="o.emeterai_serial_number"/>
                                        </div>
                                        <div style="color: #6B7280; font-size: 8px; margin-top: 2px;">
                                            UU No. 10/2020 · Perum Peruri
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Right Column: Official Company Seal & Authorized Signature Overlay -->
                    <div t-attf-class="col-5 text-center #{'offset-1' if o.emeterai_status != 'stamped' else ''}">
                        <t t-if="o.company_id.stamp_enabled">
                            <div class="small text-muted mb-1">
                                <t t-esc="o.company_id.city or 'Jakarta'"/>, 
                                <t t-if="o.invoice_date" t-esc="o.invoice_date.strftime('%d %B %Y')"/>
                            </div>
                            <div class="fw-bold small text-dark mb-2">
                                <t t-esc="o.company_id.name"/>
                            </div>

                            <!-- Overlapping Signature + Transparent Seal Canvas -->
                            <div style="position: relative; display: inline-block; min-height: 75px; min-width: 170px;">
                                <!-- Authorized Signature (PNG) -->
                                <t t-if="o.company_id.authorized_signature">
                                    <img t-att-src="image_data_uri(o.company_id.authorized_signature)" 
                                         style="max-height: 70px; max-width: 160px; position: relative; z-index: 1;"/>
                                </t>
                                <t t-else="">
                                    <div style="height: 60px;"></div>
                                </t>

                                <!-- Official Company Wet Stamp Seal (Transparent PNG, Rotated -6 deg, 82% Opacity) -->
                                <t t-if="o.company_id.company_seal">
                                    <img t-att-src="image_data_uri(o.company_id.company_seal)" 
                                         style="position: absolute; left: 10px; top: -12px; max-height: 82px; max-width: 82px; opacity: 0.82; transform: rotate(-6deg); z-index: 2; pointer-events: none;"/>
                                </t>
                            </div>

                            <!-- Signatory Name & Title -->
                            <div style="border-top: 1px solid #1E293B; margin-top: 4px; padding-top: 4px;">
                                <div class="fw-bold text-dark small" style="text-decoration: underline;">
                                    <t t-esc="o.company_id.signer_name or 'Direktur Utama'"/>
                                </div>
                                <div class="text-muted" style="font-size: 10px;">
                                    <t t-esc="o.company_id.signer_title or 'Director'"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

            </div>
        </xpath>
    </template>
</odoo>
