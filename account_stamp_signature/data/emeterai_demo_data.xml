<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Default Sandbox Mock Provider for Development -->
        <record id="emeterai_provider_sandbox_default" model="emeterai.provider">
            <field name="name">Peruri Sandbox Mock Gateway (Test Engine)</field>
            <field name="provider_type">mock</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="api_url">https://sandbox.emeterai.peruri.co.id</field>
            <field name="client_id">MOCK-CLIENT-DEV-2026</field>
            <field name="quota_balance">100</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 2. Set Default Seal and Signature on Main Company -->
        <record id="base.main_company" model="res.company">
            <field name="stamp_enabled" eval="True"/>
            <field name="signer_name">Ardian Ryan Santoso</field>
            <field name="signer_title">Direktur Utama</field>
            <field name="stamp_signature_position">bottom_right</field>
            <field name="company_seal"></field>
            <field name="authorized_signature"></field>
        </record>
    </data>
</odoo>
