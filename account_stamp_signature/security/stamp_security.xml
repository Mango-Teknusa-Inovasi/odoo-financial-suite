<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Company Rule for e-Meterai Provider -->
        <record id="emeterai_provider_comp_rule" model="ir.rule">
            <field name="name">e-Meterai Provider Multi-Company</field>
            <field name="model_id" ref="model_emeterai_provider"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
